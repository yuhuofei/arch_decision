{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arch-decision/.sdd/schema/decision.schema.json",
  "title": "Architecture Decision Output",
  "description": "Architecture Decision 的机器可读契约（Machine-readable Decision Contract）。权威实例为 specs/<id>/decision.json，由 scripts/mini_schema.py 做真 JSON Schema 校验；technology-selection.md 里的同名 YAML 代码块仅供人阅读，只做 structural validation（YAML 无标准库解析器）。对应 .sdd/templates/technology-selection.md 与 Matrix §40；evidence/constraints/alternatives/scores/review_triggers/deferred/decision_history 依 modv2.md §6,§15-§18 补全。",
  "type": "object",
  "required": ["architecture_decision"],
  "additionalProperties": false,
  "properties": {
    "architecture_decision": {
      "type": "object",
      "required": [
        "project",
        "architecture",
        "backend",
        "database",
        "evidence",
        "constraints",
        "alternatives",
        "rejected",
        "confidence"
      ],
      "properties": {
        "project": {
          "type": "object",
          "required": ["type", "scale"],
          "properties": {
            "type": {
              "type": "string",
              "description": "Project Type，见 knowledge/architecture.md §1"
            },
            "scale": { "type": "string", "examples": ["Small", "Small/Medium", "Medium", "Large"] },
            "team_size": { "type": "integer", "minimum": 1 },
            "deployment": { "type": "string" }
          }
        },
        "architecture": {
          "type": "object",
          "required": ["style", "reason"],
          "properties": {
            "style": { "type": "string", "enum": ["Monolith", "Modular Monolith", "Microservices"] },
            "reason": { "type": "string", "minLength": 4 }
          }
        },
        "backend": {
          "type": "object",
          "required": ["language"],
          "properties": {
            "language": { "type": "string" },
            "framework": { "type": "string" },
            "reason": { "type": "string", "minLength": 4 }
          }
        },
        "frontend": {
          "type": "object",
          "properties": {
            "language": { "type": "string" },
            "framework": { "type": "string" },
            "reason": { "type": "string" }
          }
        },
        "database": {
          "type": "object",
          "required": ["primary"],
          "properties": {
            "primary": { "type": "string" },
            "reason": { "type": "string", "minLength": 4 }
          }
        },
        "cache": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "technology": { "type": ["string", "null"] },
            "purpose": { "type": ["string", "null"] }
          }
        },
        "messaging": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "technology": { "type": ["string", "null"] },
            "purpose": { "type": ["string", "null"] }
          }
        },
        "search": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "technology": { "type": ["string", "null"] }
          }
        },
        "vector": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "technology": { "type": ["string", "null"] }
          }
        },
        "object_storage": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "technology": { "type": ["string", "null"] }
          }
        },
        "authentication": {
          "type": "object",
          "required": ["strategy"],
          "properties": {
            "strategy": { "type": "string", "enum": ["None", "Session", "JWT", "OIDC", "OAuth"] }
          }
        },
        "authorization": {
          "type": "object",
          "required": ["strategy"],
          "properties": {
            "strategy": { "type": "string", "examples": ["RBAC", "RBAC + resource-level", "ABAC"] }
          }
        },
        "observability": {
          "type": "object",
          "properties": {
            "logging": { "type": "boolean" },
            "metrics": { "type": "boolean" },
            "tracing": { "type": "boolean" }
          }
        },
        "testing": {
          "type": "object",
          "properties": {
            "unit": { "enum": ["Low", "Medium", "High"] },
            "integration": { "enum": ["Low", "Medium", "High"] },
            "e2e": { "enum": ["Low", "Medium", "High"] }
          }
        },
        "deployment": {
          "type": "object",
          "properties": { "strategy": { "type": "string" } }
        },
        "evidence": {
          "description": "决策依据（modv2.md §15）。禁止只写 reason 这类无法复核的理由；每条依据必须可指向来源。",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["type", "claim", "source"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["requirement", "constraint", "team", "documentation", "precedent"]
              },
              "claim": { "type": "string", "minLength": 4 },
              "source": {
                "type": "string",
                "minLength": 2,
                "description": "spec.md#FR-003 / <官方文档 URL> / project-discovery.md#team 之类可定位的引用"
              },
              "verified_at": { "type": ["string", "null"] }
            }
          }
        },
        "constraints": {
          "description": "塑造该决策的约束（P0A/P0B/P1-P3，见 decision-trees/decision-protocol.md §2）。无约束也要显式写空数组。",
          "type": "array",
          "items": { "type": "string", "minLength": 2 }
        },
        "alternatives": {
          "description": "被认真考虑过、未被淘汰但最终未选的可行候选及其权衡（modv2.md §6）。与 rejected 的边界：alternatives 是仍成立的可行备选，rejected 是被淘汰的结论；同一候选只应出现在二者之一，避免「到底被考虑还是被淘汰」的歧义。",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["option"],
            "properties": {
              "option": { "type": "string", "minLength": 1 },
              "reason": { "type": "string" }
            }
          }
        },
        "scores": {
          "description": "仅当 Hard Constraint elimination 后仍有 >=2 候选且规则无法区分时才评分（decision-protocol.md §4.1）。无评分写空数组。",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["option", "score"],
            "properties": {
              "option": { "type": "string", "minLength": 1 },
              "score": { "type": "integer", "minimum": 0, "maximum": 500 },
              "breakdown": { "type": ["string", "null"] }
            }
          }
        },
        "versions": {
          "description": "版本选择记录（策略见 knowledge/versioning.md；版本号必须核对上游官方文档，未知写 UNKNOWN，禁止编造）",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["technology", "selected", "support_status", "reason"],
            "properties": {
              "technology": { "type": "string" },
              "selected": { "type": "string" },
              "support_status": {
                "type": "string",
                "enum": ["supported", "LTS", "maintenance", "EOL", "UNKNOWN"]
              },
              "verified_at": { "type": ["string", "null"] },
              "source_url": {
                "type": ["string", "null"],
                "description": "核实该版本状态的官方文档地址（modv2.md §6）——把「核实过」变成可审计数据"
              },
              "reason": { "type": "string", "minLength": 4 }
            }
          }
        },
        "decision_status": {
          "description": "每项决策的状态标识（decision-protocol.md §6）：AUTO/RECOMMEND 不阻塞，REQUIRE_CONFIRMATION 必须人确认",
          "type": "object",
          "additionalProperties": {
            "enum": ["AUTO", "RECOMMEND", "REQUIRE_CONFIRMATION", "BLOCKED"]
          }
        },
        "complexity": {
          "description": "架构复杂度预算（decision-protocol.md §5）",
          "type": "object",
          "required": ["score", "budget"],
          "properties": {
            "score": { "type": "integer", "minimum": 0 },
            "budget": { "type": "integer", "minimum": 0 },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["component", "points"],
                "properties": {
                  "component": { "type": "string" },
                  "points": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        },
        "cost": {
          "description": "Cost 复核（本仓补充，见 decision-protocol.md §4.2）。within_budget 为 null 表示无预算数据、无法判断——此时不得写 true（modv2.md §7）。",
          "type": "object",
          "properties": {
            "recurring": { "type": "string", "description": "持续成本的计费口径，须可量化" },
            "cap": { "type": "string", "description": "成本上限；未知写 UNKNOWN" },
            "budget_basis": {
              "type": ["string", "null"],
              "description": "判定 within_budget 所依据的预算口径，例如「project monthly infrastructure budget」"
            },
            "within_budget": {
              "type": ["boolean", "null"],
              "description": "true = 已知预算范围内；false = 明确超预算；null = 无预算数据，无法判断"
            }
          }
        },
        "rejected": {
          "description": "被淘汰的候选结论及理由（Hard Constraint 失败 / 明显劣势）。与 alternatives 的边界：rejected 是淘汰结论，alternatives 是仍成立的可行备选；同一候选只应出现在二者之一。与 deferred 的区别（REJECTED=不适用 与 DEFERRED=当前不需要、条件出现重评）见 .sdd/templates/technology-selection.md——当前示例的 rejected/deferred 边界尚未收敛，见 REVIEW-2026-09-19.md 的「四审未做的事」。minItems=1 的放宽判据亦见该处。",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["option", "reason"],
            "properties": {
              "option": { "type": "string" },
              "reason": { "type": "string", "minLength": 4 }
            }
          }
        },
        "deferred": {
          "description": "DEFERRED（modv2.md §17）：当前不引入、但已登记重评条件。不要把「暂不做」一律写进 rejected —— 那会丢失重评线索。",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["decision", "reason"],
            "properties": {
              "decision": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 4 },
              "trigger": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "review_triggers": {
          "description": "重评条件（modv2.md §16）：AUTO 不是永久结论，只是「在当前证据与约束下如此」。",
          "type": "array",
          "items": { "type": "string", "minLength": 4 }
        },
        "decision_history": {
          "description": "决策变更史（modv2.md §18）：为什么改、依据什么、取代了哪条旧决策。规模扩大后再拆成 ADR。",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["decision", "from", "to", "reason"],
            "properties": {
              "decision": { "type": "string" },
              "from": { "type": "string" },
              "to": { "type": "string" },
              "changed_at": { "type": ["string", "null"] },
              "reason": { "type": "string", "minLength": 4 },
              "trigger": { "type": ["string", "null"] },
              "supersedes": { "type": ["string", "null"] }
            }
          }
        },
        "risks": { "type": "array", "items": { "type": "string" } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "confidence": {
          "type": "object",
          "required": ["overall"],
          "properties": {
            "overall": { "type": "integer", "minimum": 0, "maximum": 5 }
          }
        }
      }
    }
  }
}
